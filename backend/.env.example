# Application
APP_NAME="WriteFlow AI"
APP_ENV=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# NVIDIA Hosted LLM API
# Obtain free API key from https://build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Supported free models include:
# - nvidia/nemotron-3.5-lightning-30b-a3b (Fast, efficient Nemotron 3.5 Lightning)
# - nvidia/llama-3.1-nemotron-70b-instruct (Nemotron 70B reasoning)
# - meta/llama-3.3-70b-instruct
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
LLM_TIMEOUT_SECONDS=45.0
ALLOW_MOCK_FALLBACK=true

# Database (defaults to local SQLite; optionally connect Supabase Postgres)
DATABASE_URL=sqlite:///./writeflow.db
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
