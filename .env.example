# ==========================================
# WriteFlow AI - Unified Environment Template
# ==========================================

# 1. NVIDIA Hosted LLM API
# Get your free API key at: https://build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Default model: Nemotron 3.5 Lightning 30B (or nvidia/llama-3.1-nemotron-70b-instruct)
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# 2. Next.js Frontend Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:8000
PORT=3000

# 3. Supabase Database & Auth (Optional for local dev, used in production)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 4. Python Backend Configuration
APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATABASE_URL=sqlite:///./writeflow.db
ALLOW_MOCK_FALLBACK=true
